{
  "name": "mrden/forker",
  "description": "Process forker",
  "type": "library",
  "keywords": [
    "forker",
    "fork",
    "process"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pcntl": "*",
    "ext-posix": "*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3",
    "phpunit/phpunit": "^11",
    "vimeo/psalm": "^6"
  },
  "authors": [
    {
      "name": "Denis Kiselev",
      "email": "kiselevden911@yandex.ru"
    }
  ],
  "autoload": {
    "psr-4": {
      "Mrden\\Forker\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "bin": [
    "bin/forker"
  ],
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "bump-dev": [
      "@composer bump --dev-only",
      "@composer bin all bump --dev-only"
    ],
    "fixcs": "php-cs-fixer fix --diff",
    "psalm": "psalm --show-info=true --no-diff --no-cache --error-level=INFO_LEVEL",
    "test": "phpunit",
    "test:unit": "phpunit",
    "test:integration": "phpunit --configuration phpunit.integration.xml",
    "test:stress": "phpunit --group stress",
    "test:all": [
      "@test:unit",
      "@test:integration"
    ]
  }
}
